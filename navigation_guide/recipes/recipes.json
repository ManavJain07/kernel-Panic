{
  "recipes": [
    {
      "id": "view_around",
      "title": "Move around the 3D view",
      "summary": "Orbit, pan, zoom and get unlost.",
      "keywords": [
        "navigate",
        "look",
        "orbit",
        "pan",
        "zoom",
        "view",
        "rotate view",
        "around",
        "camera view",
        "lost"
      ],
      "steps": [
        {
          "short": "Orbit",
          "text": "Hold the middle mouse button and drag over the viewport to rotate your view. No middle button? Drag the small axis gizmo at the top-right of the viewport. Press 'I did this' when done.",
          "shortcut": "Middle mouse drag"
        },
        {
          "short": "Pan",
          "text": "Hold Shift and drag with the middle mouse button to slide the view sideways. Press 'I did this' when done.",
          "shortcut": "Shift + Middle mouse drag"
        },
        {
          "short": "Zoom",
          "text": "Scroll the mouse wheel to zoom in and out. Press 'I did this' when done.",
          "shortcut": "Scroll wheel"
        },
        {
          "short": "Zoom to object",
          "text": "Select an object, then zoom to it. On a laptop use View > Frame Selected.",
          "shortcut": "Numpad .",
          "action": "frame_selected",
          "action_label": "Frame selected"
        },
        {
          "short": "Show everything",
          "text": "Lost? Show the whole scene.",
          "shortcut": "Home",
          "action": "view_all",
          "action_label": "Show everything"
        }
      ]
    },
    {
      "id": "wall",
      "title": "Build a wall",
      "summary": "Turn a cube into a long, thin, tall wall that stands on the ground.",
      "keywords": [
        "wall",
        "fence",
        "barrier",
        "partition",
        "brick",
        "boundary"
      ],
      "steps": [
        {
          "short": "Have a cube",
          "text": "Make sure there is a cube in the scene. Add one if not.",
          "shortcut": "Shift + A > Mesh > Cube",
          "mode": "OBJECT",
          "done": {
            "min_mesh_objects": 1
          },
          "action": "add_cube",
          "action_label": "Add a cube"
        },
        {
          "short": "Select the cube",
          "text": "Click the cube in the viewport so it has an orange outline.",
          "shortcut": "Left click",
          "mode": "OBJECT",
          "done": {
            "min_selected": 1,
            "active_type": "MESH"
          },
          "highlight": true
        },
        {
          "short": "Make it long",
          "text": "With the mouse over the viewport, press S, then X, type 4 and press Enter. This stretches the cube into a long wall.",
          "shortcut": "S, X, 4, Enter",
          "mode": "OBJECT",
          "done": {
            "dim_min": {
              "x": 6
            }
          },
          "axis": "X",
          "highlight": true
        },
        {
          "short": "Make it thin",
          "text": "Press S, then Y, type 0.2 and press Enter to make the wall thin.",
          "shortcut": "S, Y, 0.2, Enter",
          "mode": "OBJECT",
          "done": {
            "dim_max": {
              "y": 1
            }
          },
          "axis": "Y",
          "highlight": true
        },
        {
          "short": "Make it tall",
          "text": "Press S, then Z, type 1.5 and press Enter to make the wall taller.",
          "shortcut": "S, Z, 1.5, Enter",
          "mode": "OBJECT",
          "done": {
            "dim_min": {
              "z": 2.5
            }
          },
          "axis": "Z",
          "highlight": true
        },
        {
          "short": "Lift onto ground",
          "text": "The wall is sunk into the ground grid. Press G, then Z, type 1.5 and press Enter to lift it.",
          "shortcut": "G, Z, 1.5, Enter",
          "mode": "OBJECT",
          "done": {
            "bottom_z_min": -0.05
          },
          "axis": "Z",
          "highlight": true
        }
      ]
    },

    {
      "id": "repeat",
      "title": "Repeat an object in a row",
      "summary": "Use an Array modifier for fences, columns and railings.",
      "keywords": [
        "repeat",
        "array",
        "row",
        "fence",
        "columns",
        "line of",
        "copies",
        "pattern",
        "multiple",
        "railing"
      ],
      "steps": [
        {
          "short": "Select the object",
          "text": "Click the object you want to repeat.",
          "shortcut": "Left click",
          "mode": "OBJECT",
          "done": {
            "min_selected": 1,
            "active_type": "MESH"
          },
          "highlight": true
        },
        {
          "short": "Add Array modifier",
          "text": "In the Properties editor on the right, open the Modifiers tab (wrench icon). Click Add Modifier > Generate > Array.",
          "shortcut": "Wrench tab > Add Modifier",
          "mode": "OBJECT",
          "done": {
            "has_modifier": "ARRAY"
          }
        },
        {
          "short": "Set the count",
          "text": "Change Count to how many copies you want, for example 5. By default the copies sit side by side along X. Press 'I did this' when done.",
          "shortcut": "Array > Count"
        },
        {
          "short": "Set the spacing",
          "text": "Change Factor X under Relative Offset to adjust gaps: 1 means touching, 1.5 leaves a gap. Press 'I did this' when done.",
          "shortcut": "Array > Relative Offset"
        }
      ]
    },
    {
      "id": "window_hole",
      "title": "Cut a window or door hole in a wall",
      "summary": "Use a second cube and a Boolean modifier to cut an opening.",
      "keywords": [
        "window",
        "door",
        "hole",
        "opening",
        "cut",
        "boolean",
        "doorway",
        "gap"
      ],
      "steps": [
        {
          "short": "Select the wall",
          "text": "Click the wall you want to cut a hole in.",
          "shortcut": "Left click",
          "mode": "OBJECT",
          "done": {
            "min_selected": 1,
            "active_type": "MESH"
          },
          "highlight": true
        },
        {
          "short": "Add a cutter cube",
          "text": "Add a new cube. It will be the shape of the hole.",
          "shortcut": "Shift + A > Mesh > Cube",
          "mode": "OBJECT",
          "done": {
            "new_object": true
          },
          "action": "add_cube",
          "action_label": "Add a cube",
          "highlight": true
        },
        {
          "short": "Place the cutter",
          "text": "Move (G) and scale (S) the new cube so it overlaps the wall where the window or door should be. Click when it looks right, then press 'I did this'.",
          "shortcut": "G",
          "mode": "OBJECT",
          "highlight": true
        },
        {
          "short": "Select the wall again",
          "text": "Click the wall (not the cutter) to select it. Then press 'I did this'.",
          "shortcut": "Left click",
          "mode": "OBJECT",
          "highlight": true
        },
        {
          "short": "Add Boolean modifier",
          "text": "In the Properties editor on the right, open the Modifiers tab (wrench icon). Click Add Modifier > Generate > Boolean.",
          "shortcut": "Wrench tab > Add Modifier",
          "mode": "OBJECT",
          "done": {
            "has_modifier": "BOOLEAN"
          }
        },
        {
          "short": "Pick the cutter",
          "text": "In the Boolean modifier, keep Operation on Difference and click the Object box. Choose your cutter cube.",
          "shortcut": "Boolean > Object",
          "mode": "OBJECT",
          "done": {
            "modifier_ready": "BOOLEAN"
          }
        },
        {
          "short": "Hide the cutter",
          "text": "Click the cutter cube, then press H to hide it. The hole is now visible. Press 'I did this' when done.",
          "shortcut": "H",
          "mode": "OBJECT"
        }
      ]
    },
